{
  "name": "urlaubsverwaltung",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "pnpm -r --workspace-concurrency=1 run lint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "build": "pnpm run typecheck && pnpm -r --workspace-concurrency=1 run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "pnpm --filter @urlaub/api run dev",
    "bench": "bash scripts/bench.sh",
    "prepare": "husky",
    "commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.1.0",
    "@eslint/js": "^9.39.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.15.0"
}
