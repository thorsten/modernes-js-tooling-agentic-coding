{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm check:affected)",
      "Bash(pnpm test:json)",
      "Bash(pnpm format)",
      "Bash(pnpm bench)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Read(//**)",
      "Edit(packages/**)",
      "Edit(docs/**)"
    ],
    "deny": [
      "Read(node_modules/**)",
      "Read(.pnpm-store/**)",
      "Read(pnpm-lock.yaml)",
      "Read(packages/*/dist/**)",
      "Read(packages/holidays/test/fixtures/**)",
      "Bash(pnpm install:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(rm:*)"
    ]
  }
}
