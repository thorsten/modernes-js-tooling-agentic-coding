{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm check:affected)",
      "Bash(pnpm test:json)",
      "Bash(pnpm format)",
      "Bash(pnpm bench)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Read(//**)",
      "Edit(packages/**)",
      "Edit(docs/**)",
      "mcp__urlaub-hr__get_employee",
      "mcp__urlaub-hr__list_employees",
      "mcp__urlaub-hr__list_absences",
      "mcp__urlaub-hr__get_holidays"
    ],
    "deny": [
      "Read(node_modules/**)",
      "Read(.pnpm-store/**)",
      "Read(pnpm-lock.yaml)",
      "Read(packages/*/dist/**)",
      "Read(packages/holidays/test/fixtures/**)",
      "Bash(pnpm install:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(rm:*)",
      "Read(data/**)"
    ],
    "ask": ["mcp__urlaub-hr__request_leave"]
  }
}
